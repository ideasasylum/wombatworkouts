<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-h1 text-[rgb(26,26,26)] mb-2">Connected apps</h1>
  <p class="text-body text-[rgb(107,114,128)] mb-8">
    Apps you've allowed to access your Wombat Workouts account through OAuth.
    Personal access tokens are managed on the
    <%= link_to "tokens page", personal_access_tokens_path, class: "underline" %>.
  </p>

  <% if flash[:notice] %>
    <div class="mb-4 p-3 bg-green-50 border border-green-200 rounded-sm text-sm text-green-800"><%= flash[:notice] %></div>
  <% end %>

  <% if @applications.any? %>
    <ul class="divide-y divide-[rgb(204,204,204)] border border-[rgb(204,204,204)] rounded-sm">
      <% @applications.each do |application| %>
        <li class="flex items-center justify-between p-4">
          <div>
            <div class="text-button text-[rgb(26,26,26)]"><%= application.name %></div>
            <div class="text-sm text-[rgb(107,114,128)]">
              Connected <%= time_ago_in_words(application.created_at) %> ago
            </div>
          </div>
          <%= button_to "Revoke", connected_app_path(application),
            method: :delete,
            class: "px-3 py-2 border border-[rgb(204,204,204)] text-button text-[rgb(26,26,26)] bg-white hover:bg-gray-50 rounded-sm",
            form: {data: {turbo_confirm: "Revoke #{application.name}'s access?"}} %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-body text-[rgb(107,114,128)]">No connected apps yet.</p>
  <% end %>
</div>
