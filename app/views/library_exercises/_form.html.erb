<%= form_with model: library_exercise, url: library_exercise_path(library_exercise), class: "space-y-4" do |f| %>
  <% if library_exercise.errors.any? %>
    <div class="rounded-sm bg-red-50 p-4 border border-red-200">
      <h3 class="text-sm font-medium text-red-800">
        <%= pluralize(library_exercise.errors.count, "error") %> prohibited this exercise from being saved:
      </h3>
      <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
        <% library_exercise.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Exercise Name", class: "form-label" %>
    <%= f.text_field :name, required: true, class: "form-input #{library_exercise.errors[:name].any? ? 'border-red-300' : ''}" %>
  </div>

  <div>
    <%= f.label :video_url, "Video URL (optional)", class: "form-label" %>
    <%= f.url_field :video_url, placeholder: "https://youtube.com/watch?v=...",
          class: "form-input #{library_exercise.errors[:video_url].any? ? 'border-red-300' : ''}" %>
  </div>

  <div>
    <%= f.label :description, "Description (optional)", class: "form-label" %>
    <%= f.hidden_field :description, id: "library_exercise_description_hidden_#{library_exercise.id}" %>
    <div id="library-exercise-description-editor-<%= library_exercise.id %>" class="border border-gray-300 rounded-sm" style="height: 250px;"></div>
  </div>

  <script>
    (function() {
      const editorId = 'library-exercise-description-editor-<%= library_exercise.id %>';
      const hiddenFieldId = 'library_exercise_description_hidden_<%= library_exercise.id %>';

      if (document.getElementById(editorId).dataset.initialized) {
        return;
      }
      document.getElementById(editorId).dataset.initialized = 'true';

      const [editor] = new OverType('#' + editorId, {
        value: <%= raw library_exercise.description.to_json %> || '',
        placeholder: 'Use markdown to format your description...',
        onChange: (value) => {
          document.getElementById(hiddenFieldId).value = value;
        }
      });
      document.getElementById(hiddenFieldId).value = editor.getValue();
    })();
  </script>

  <div class="flex gap-3 justify-end">
    <%= link_to "Cancel", library_exercises_path,
        class: "inline-flex items-center justify-center px-6 py-3 border border-[rgb(26,26,26)] text-base font-medium rounded-sm text-[rgb(26,26,26)] bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-colors min-h-[44px]" %>
    <%= render "shared/button",
      text: "Update Exercise",
      icon: "save",
      icon_position: :left,
      type: :primary,
      size: :base,
      html_options: { type: "submit" } %>
  </div>
<% end %>
