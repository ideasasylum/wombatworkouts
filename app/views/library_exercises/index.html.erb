<% content_for :title, "Exercise Library - Wombat Workouts" %>

<div class="min-h-screen py-6 md:py-12 px-4 sm:px-6 lg:px-8 w-full">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-h1 text-[rgb(26,26,26)]">Exercise Library</h1>
    </div>

    <p class="text-body text-[rgb(107,114,128)] mb-6">
      Exercises you create are saved here. You can re-use them when adding exercises to your programs.
    </p>

    <% if @library_exercises.empty? %>
      <div class="bg-white border border-[rgb(204,204,204)] p-12 text-center">
        <div class="max-w-md mx-auto">
          <h2 class="text-h2 text-[rgb(26,26,26)] mb-2">Your library is empty</h2>
          <p class="text-body text-[rgb(107,114,128)] mb-6">Add exercises to a program and they'll automatically appear here.</p>
          <%= render 'shared/button',
            text: 'Go to Programs',
            url: programs_path,
            type: :primary,
            size: :base %>
        </div>
      </div>
    <% else %>
      <div class="space-y-3">
        <% @library_exercises.each do |library_exercise| %>
          <div class="bg-white border border-[rgb(204,204,204)] rounded-sm p-3 md:p-6">
            <div class="flex items-start gap-2">
              <div class="flex-grow min-w-0">
                <%= link_to edit_library_exercise_path(library_exercise), class: "group" do %>
                  <h3 class="text-base font-medium text-[rgb(26,26,26)] leading-6 group-hover:text-gray-600 transition-colors"><%= library_exercise.name %></h3>
                <% end %>

                <% if library_exercise.description.present? %>
                  <div class="prose prose-sm max-w-none mt-2 text-gray-600">
                    <%= markdown(library_exercise.description) %>
                  </div>
                <% end %>

                <% if library_exercise.video_url.present? %>
                  <div class="mt-3">
                    <%= link_to library_exercise.video_url, target: "_blank", class: "text-sm text-[rgb(26,26,26)] hover:underline inline-flex items-center" do %>
                      <%= render "shared/icons/play", class: "w-4 h-4 mr-1" %>
                      Watch video
                    <% end %>
                  </div>
                <% end %>
              </div>

              <div class="flex items-start flex-shrink-0 gap-1">
                <%= link_to edit_library_exercise_path(library_exercise),
                    class: "inline-flex items-center justify-center border border-transparent bg-transparent text-[rgb(26,26,26)] hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-colors p-1 md:p-2 min-h-[44px] min-w-[44px] rounded-sm",
                    "aria-label": "Edit exercise" do %>
                  <%= render "shared/icons/pencil", class: "w-5 h-5" %>
                <% end %>

                <%= button_to library_exercise_path(library_exercise),
                  method: :delete,
                  form: { data: { turbo_confirm: "Remove this exercise from your library?" } },
                  class: "inline-flex items-center justify-center border border-transparent bg-transparent text-[rgb(26,26,26)] hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-colors p-1 md:p-2 min-h-[44px] min-w-[44px] rounded-sm",
                  "aria-label": "Delete exercise" do %>
                  <%= render "shared/icons/trash", class: "w-5 h-5" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
