<%
# Workout Heatmap
#
# Shows last 12 weeks of completed workouts as a 12-column × 7-row grid.
# Each cell is colored by the program the workout belongs to, cycling
# through a 10-color palette in program-creation order per user.
#
# @param heatmap [WorkoutHeatmap]
%>

<section class="mt-12" aria-labelledby="activity-heading">
  <h2 id="activity-heading" class="text-h1 text-[rgb(26,26,26)] mb-6">Activity</h2>

  <div class="bg-white border border-[rgb(204,204,204)] p-4 md:p-6">
    <p class="text-body text-[rgb(107,114,128)] mb-4">Last 12 weeks</p>

    <div class="grid grid-cols-12 gap-[3px]" role="img" aria-label="Workout activity over the last 12 weeks">
      <% heatmap.weeks.each do |week| %>
        <div class="flex flex-col gap-[3px]">
          <% week.each do |cell| %>
            <%
              base_classes = "aspect-square w-full"
              ring_class = cell.today ? "outline outline-1 outline-[rgb(26,26,26)]" : ""
              date_label = cell.date.strftime("%a %-d %b")
              tooltip = if cell.workout?
                "#{date_label} — #{cell.program_title}"
              else
                date_label
              end
            %>
            <div
              class="<%= base_classes %> <%= ring_class %>"
              style="background-color: <%= cell.color %>;"
              title="<%= tooltip %>"
            ></div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if heatmap.legend.any? %>
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
        <% heatmap.legend.each do |entry| %>
          <div class="flex items-center gap-2 text-body">
            <span class="inline-block w-3 h-3 flex-shrink-0" style="background-color: <%= entry[:color] %>;"></span>
            <span class="text-[rgb(26,26,26)]"><%= entry[:program].title %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
