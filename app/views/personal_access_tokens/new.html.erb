<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-h1 text-[rgb(26,26,26)] mb-4">New API token</h1>
  <p class="text-body text-[rgb(107,114,128)] mb-6">
    Give the token a name so you can recognize it later (e.g. "Claude Desktop").
  </p>

  <%= form_with model: @token, url: personal_access_tokens_path, local: true, class: "space-y-4" do |f| %>
    <% if @token.errors.any? %>
      <div class="p-3 bg-red-50 border border-red-200 rounded-sm text-sm text-red-800">
        <%= @token.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-button text-[rgb(26,26,26)] mb-1" %>
      <%= f.text_field :name, autofocus: true, required: true,
        class: "w-full px-3 py-2 border border-[rgb(204,204,204)] rounded-sm focus:outline-none focus:ring-2 focus:ring-[rgb(107,93,82)]" %>
    </div>

    <div class="flex items-center space-x-3">
      <%= f.submit "Create token",
        class: "inline-flex items-center px-4 py-2 border border-transparent text-button text-white bg-[rgb(107,93,82)] hover:bg-[rgb(80,70,60)] rounded-sm" %>
      <%= link_to "Cancel", personal_access_tokens_path,
        class: "text-button text-[rgb(107,114,128)] hover:text-[rgb(26,26,26)]" %>
    </div>
  <% end %>
</div>
