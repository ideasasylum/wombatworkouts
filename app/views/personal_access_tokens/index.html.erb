<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-h1 text-[rgb(26,26,26)] mb-2">Personal settings</h1>
  <p class="text-body text-[rgb(107,114,128)] mb-8">Signed in as <%= current_user.email %>.</p>

  <section>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-h2 text-[rgb(26,26,26)]">Connect with an AI</h2>
      <%= link_to "New token", new_personal_access_token_path,
        class: "inline-flex items-center px-4 py-2 border border-transparent text-button text-white bg-[rgb(107,93,82)] hover:bg-[rgb(80,70,60)] rounded-sm" %>
    </div>

    <p class="text-body text-[rgb(107,114,128)] mb-4">
      Wombat Workouts speaks <a href="https://modelcontextprotocol.io" class="underline hover:text-[rgb(26,26,26)]">Model Context Protocol</a>, so an AI assistant like Claude can build and edit programs in your account on your behalf.
    </p>

    <div class="mb-4 p-4 bg-[rgb(252,248,243)] border border-[rgb(204,204,204)] rounded-sm space-y-3 text-body">
      <p class="text-button text-[rgb(26,26,26)]">To connect:</p>
      <ol class="list-decimal list-inside space-y-2 text-[rgb(26,26,26)]">
        <li>Create a token below and copy it.</li>
        <li>
          In your AI client (e.g. Claude Desktop or claude.ai), add a custom MCP connector pointing to:
          <code class="block break-all bg-white p-2 mt-2 border border-[rgb(204,204,204)] rounded-sm font-mono text-sm"><%= "#{request.base_url}/mcp" %></code>
        </li>
        <li>Use the token as a Bearer credential when prompted.</li>
      </ol>
    </div>

    <% if @just_created_token.present? %>
      <div class="mb-6 p-4 border-2 border-[rgb(107,93,82)] bg-[rgb(252,248,243)] rounded-sm">
        <p class="text-button text-[rgb(26,26,26)] mb-2">Copy your new token now. You won't be able to see it again.</p>
        <code class="block break-all text-sm bg-white p-3 border border-[rgb(204,204,204)] rounded-sm font-mono"><%= @just_created_token %></code>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="mb-4 p-3 bg-green-50 border border-green-200 rounded-sm text-sm text-green-800"><%= flash[:notice] %></div>
    <% end %>

    <h3 class="text-button text-[rgb(26,26,26)] mt-6 mb-2">Active tokens</h3>
    <% if @tokens.any? %>
      <ul class="divide-y divide-[rgb(204,204,204)] border border-[rgb(204,204,204)] rounded-sm">
        <% @tokens.each do |token| %>
          <li class="flex items-center justify-between p-4">
            <div>
              <div class="text-button text-[rgb(26,26,26)]"><%= token.name %></div>
              <div class="text-sm text-[rgb(107,114,128)]">
                Created <%= token.created_at.to_date.to_fs(:long) %>
                <% if token.last_used_at %> · Last used <%= time_ago_in_words(token.last_used_at) %> ago
                <% else %> · Never used
                <% end %>
              </div>
            </div>
            <%= button_to "Revoke", personal_access_token_path(token),
              method: :delete,
              class: "px-3 py-2 border border-[rgb(204,204,204)] text-button text-[rgb(26,26,26)] bg-white hover:bg-gray-50 rounded-sm",
              form: {data: {turbo_confirm: "Revoke '#{token.name}'? Anything using it will stop working."}} %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-body text-[rgb(107,114,128)]">No active tokens.</p>
    <% end %>

    <% if @revoked_tokens.any? %>
      <h3 class="text-button text-[rgb(26,26,26)] mt-8 mb-2">Revoked</h3>
      <ul class="divide-y divide-[rgb(204,204,204)] border border-[rgb(204,204,204)] rounded-sm text-sm text-[rgb(107,114,128)]">
        <% @revoked_tokens.each do |token| %>
          <li class="p-4">
            <%= token.name %> — revoked <%= time_ago_in_words(token.revoked_at) %> ago
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
