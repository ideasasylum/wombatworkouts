<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-h1 text-[rgb(26,26,26)] mb-4">Authorize <%= @pre_auth.client.name %></h1>
  <p class="text-body text-[rgb(107,114,128)] mb-6">
    <strong><%= @pre_auth.client.name %></strong> is requesting access to your Wombat Workouts account.
    It will be able to read and modify your workout programs and exercises through the MCP server.
  </p>

  <div class="p-3 bg-amber-50 border border-amber-200 rounded-sm text-sm text-amber-900 mb-6">
    Only allow this if you initiated this connection. You can revoke access at any time from
    <%= link_to "Connected apps", connected_apps_path, class: "underline" %>.
  </div>

  <div class="flex items-center space-x-3">
    <%= form_tag oauth_authorization_path, method: :post, class: "inline" do %>
      <%= hidden_field_tag :client_id, @pre_auth.client.uid %>
      <%= hidden_field_tag :redirect_uri, @pre_auth.redirect_uri %>
      <%= hidden_field_tag :state, @pre_auth.state %>
      <%= hidden_field_tag :response_type, @pre_auth.response_type %>
      <%= hidden_field_tag :scope, @pre_auth.scope %>
      <%= hidden_field_tag :code_challenge, @pre_auth.code_challenge %>
      <%= hidden_field_tag :code_challenge_method, @pre_auth.code_challenge_method %>
      <%= hidden_field_tag :resource, params[:resource] %>
      <%= submit_tag "Allow",
        class: "inline-flex items-center px-4 py-2 border border-transparent text-button text-white bg-[rgb(107,93,82)] hover:bg-[rgb(80,70,60)] rounded-sm cursor-pointer" %>
    <% end %>

    <%= form_tag oauth_authorization_path, method: :delete, class: "inline" do %>
      <%= hidden_field_tag :client_id, @pre_auth.client.uid %>
      <%= hidden_field_tag :redirect_uri, @pre_auth.redirect_uri %>
      <%= hidden_field_tag :state, @pre_auth.state %>
      <%= submit_tag "Deny",
        class: "inline-flex items-center px-4 py-2 border border-[rgb(204,204,204)] text-button text-[rgb(26,26,26)] bg-white hover:bg-gray-50 rounded-sm cursor-pointer" %>
    <% end %>
  </div>
</div>
